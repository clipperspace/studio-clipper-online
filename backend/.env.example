# Salin file ini menjadi ".env" lalu isi API key Anda.
# Dapatkan API key gratis di: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini. "auto" = otomatis pilih versi tercepat yang tersedia untuk API key Anda.
# Bisa juga diisi nama tertentu, mis. gemini-3.6-flash / gemini-3.1-flash-lite
GEMINI_MODEL_FAST=auto
GEMINI_MODEL_LITE=auto

# Mode Seimbang/Mendalam: jalankan Flash-Lite paralel jika Flash belum menjawab dalam N detik
HEDGE_FLASH_SECONDS=20
HEDGE_DEEP_SECONDS=45

# File hasil dihapus otomatis setelah N menit
FILE_TTL_MINUTES=60
# Durasi maksimal per klip (detik)
MAX_CLIP_SECONDS=1800
# Jumlah proses download/analisa paralel
MAX_CONCURRENT_JOBS=2
